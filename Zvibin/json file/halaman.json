{
    "application_name": "Pasaria",
    "application_type": "Marketplace UMKM",
    "pages": {
        "home": {
            "title": "Beranda",
            "components": [
                {
                    "type": "sticky_navbar",
                    "items": [
                        "logo_button",
                        "search_bar",
                        "cart_button",
                        "notification_button",
                        "chat_button",
                        "seller_center_button",
                        "profile_button"
                    ]
                },
                {
                    "type": "promo_banner_carousel",
                    "description": "Banner promosi UMKM dan event marketplace"
                },
                {
                    "type": "category_section",
                    "description": "Daftar kategori produk"
                },
                {
                    "type": "product_catalog",
                    "grid_columns": 5,
                    "max_products_per_load": 10,
                    "load_more_button": true
                },
                {
                    "type": "footer"
                }
            ]
        },
        "product_detail": {
            "title": "Detail Produk",
            "components": [
                {
                    "type": "sticky_navbar"
                },
                {
                    "type": "product_gallery",
                    "features": [
                        "multiple_images",
                        "zoom_preview"
                    ]
                },
                {
                    "type": "product_information",
                    "fields": [
                        "product_name",
                        "total_sold",
                        "rating",
                        "review_count",
                        "price",
                        "stock",
                        "variants",
                        "product_description"
                    ]
                },
                {
                    "type": "seller_information",
                    "fields": [
                        "store_name",
                        "store_rating",
                        "store_location",
                        "chat_button",
                        "visit_store_button"
                    ]
                },
                {
                    "type": "customer_reviews"
                },
                {
                    "type": "sticky_action_panel",
                    "position": "right",
                    "buttons": [
                        "add_to_cart",
                        "buy_now",
                        "wishlist",
                        "chat_seller",
                        "share_product"
                    ]
                },
                {
                    "type": "related_products",
                    "grid_columns": 5
                },
                {
                    "type": "footer"
                }
            ]
        },
        "cart": {
            "title": "Keranjang",
            "components": [
                {
                    "type": "sticky_navbar"
                },
                {
                    "type": "select_all_checkbox"
                },
                {
                    "type": "cart_table",
                    "features": [
                        "change_quantity",
                        "remove_item",
                        "select_item"
                    ]
                },
                {
                    "type": "shopping_summary",
                    "position": "right",
                    "fields": [
                        "subtotal",
                        "shipping_cost",
                        "total_price"
                    ],
                    "buttons": [
                        "checkout"
                    ]
                },
                {
                    "type": "recommended_products",
                    "grid_columns": 4
                },
                {
                    "type": "footer"
                }
            ]
        },
        "chat": {
            "title": "Pesan",
            "components": [
                {
                    "type": "conversation_list"
                },
                {
                    "type": "chat_room"
                },
                {
                    "type": "message_input"
                }
            ]
        },
        "notifications_popup": {
            "title": "Notifikasi",
            "type": "popup",
            "sections": [
                "waiting_confirmation",
                "processing_order",
                "shipping_order",
                "completed_order"
            ]
        },
        "notifications_page": {
            "title": "Pengaturan Notifikasi",
            "settings": [
                "payment_notification",
                "order_confirmation_notification",
                "processing_notification",
                "shipping_notification",
                "completed_notification",
                "promotion_notification"
            ]
        },
        "profile": {
            "title": "Profil",
            "tabs": {
                "biodata": {
                    "fields": [
                        "profile_photo",
                        "full_name",
                        "phone_number",
                        "email",
                        "birth_date"
                    ]
                },
                "address_list": {
                    "features": [
                        "add_address",
                        "edit_address",
                        "delete_address",
                        "set_primary_address"
                    ]
                },
                "notifications": {
                    "redirect_to": "notifications_page"
                }
            }
        },
        "seller_center": {
            "title": "Pusat Penjual",
            "dashboard": {
                "widgets": [
                    "today_sales",
                    "monthly_sales",
                    "total_orders",
                    "total_products",
                    "total_revenue",
                    "store_rating",
                    "visitor_statistics",
                    "recent_orders"
                ]
            },
            "orders": {
                "tabs": [
                    "all_orders",
                    "new_orders",
                    "ready_to_ship",
                    "shipping",
                    "completed_orders",
                    "cancelled_orders",
                    "returned_orders"
                ]
            },
            "products": {
                "top_actions": [
                    "add_product"
                ],
                "product_card_fields": [
                    "product_image",
                    "product_name",
                    "price",
                    "stock",
                    "status",
                    "total_sold",
                    "rating",
                    "last_updated"
                ]
            },
            "product_detail": {
                "editable_fields": [
                    "product_name",
                    "category",
                    "price",
                    "discount",
                    "stock",
                    "sku",
                    "weight",
                    "product_images",
                    "variants",
                    "description",
                    "shipping_options"
                ]
            },
            "withdraw_balance": {
                "fields": [
                    "available_balance",
                    "pending_balance",
                    "bank_account"
                ],
                "actions": [
                    "request_withdraw"
                ]
            },
            "analytics": {
                "reports": [
                    "sales_report",
                    "visitor_report",
                    "product_performance",
                    "customer_report"
                ]
            }
        },
        "admin_panel": {
            "title": "Dashboard Admin",
            "sidebar_menu": [
                "dashboard",
                "orders_management",
                "customers_management",
                "sellers_management",
                "categories_management",
                "products_management",
                "transactions_management",
                "withdraw_management",
                "complaints_management",
                "reviews_management",
                "promotions_management",
                "reports_analytics",
                "admins_roles",
                "system_settings"
            ],
            "dashboard": {
                "widgets": [
                    "total_revenue",
                    "total_orders",
                    "total_customers",
                    "total_sellers",
                    "total_products",
                    "pending_orders",
                    "completed_orders",
                    "monthly_sales_chart",
                    "recent_transactions",
                    "top_selling_products",
                    "top_sellers",
                    "latest_complaints"
                ]
            },
            "orders_management": {
                "tabs": [
                    "all_orders",
                    "pending_payment",
                    "waiting_confirmation",
                    "processing",
                    "ready_to_ship",
                    "shipping",
                    "completed",
                    "cancelled",
                    "refunded"
                ]
            },
            "customers_management": {
                "fields": [
                    "customer_id",
                    "profile_photo",
                    "full_name",
                    "email",
                    "phone_number",
                    "registration_date",
                    "total_orders",
                    "total_spent",
                    "account_status"
                ]
            },
            "sellers_management": {
                "fields": [
                    "seller_id",
                    "store_name",
                    "owner_name",
                    "email",
                    "phone_number",
                    "verification_status",
                    "total_products",
                    "total_sales",
                    "store_rating"
                ],
                "actions": [
                    "verify_store",
                    "suspend_store",
                    "activate_store"
                ]
            },
            "categories_management": {
                "actions": [
                    "add_category",
                    "edit_category",
                    "delete_category"
                ]
            },
            "products_management": {
                "actions": [
                    "approve_product",
                    "reject_product",
                    "edit_product",
                    "delete_product"
                ]
            },
            "transactions_management": {
                "fields": [
                    "transaction_id",
                    "order_id",
                    "payment_method",
                    "transaction_amount",
                    "marketplace_fee",
                    "transaction_status",
                    "transaction_date"
                ]
            },
            "withdraw_management": {
                "fields": [
                    "withdraw_id",
                    "seller_name",
                    "bank_account",
                    "request_amount",
                    "request_date",
                    "status"
                ]
            },
            "complaints_management": {
                "fields": [
                    "complaint_id",
                    "customer_name",
                    "seller_name",
                    "order_id",
                    "complaint_type",
                    "status"
                ]
            },
            "reviews_management": {
                "actions": [
                    "hide_review",
                    "delete_review"
                ]
            },
            "promotions_management": {
                "modules": [
                    "voucher_management",
                    "flash_sale_management",
                    "banner_management",
                    "discount_campaign_management"
                ]
            },
            "reports_analytics": {
                "reports": [
                    "sales_report",
                    "revenue_report",
                    "transaction_report",
                    "customer_growth_report",
                    "seller_performance_report",
                    "product_performance_report"
                ]
            },
            "admins_roles": {
                "roles": [
                    "super_admin",
                    "finance_admin",
                    "customer_service_admin",
                    "product_admin",
                    "marketing_admin"
                ]
            },
            "system_settings": {
                "settings": [
                    "marketplace_information",
                    "payment_gateway",
                    "shipping_providers",
                    "email_configuration",
                    "notification_configuration",
                    "maintenance_mode",
                    "backup_database"
                ]
            }
        }
    },
    "global_features": [
        "wishlist",
        "search_products",
        "product_filter",
        "product_sorting",
        "voucher_system",
        "flash_sale",
        "seller_chat",
        "order_tracking",
        "review_and_rating",
        "favorite_store",
        "responsive_design",
        "dark_mode",
        "multi_address_support",
        "seller_verification",
        "withdraw_system",
        "commission_management",
        "complaint_center",
        "admin_activity_logs",
        "analytics_dashboard",
        "product_moderation",
        "automated_backup",
        "fraud_detection",
        "real_time_notifications",
        "sales_analytics",
        "customer_support_ticket",
        "refund_management",
        "return_management",
        "store_verification",
        "role_based_access_control"
    ]
}