{
  "project": {
    "name": "SemarCommerce",
    "type": "Marketplace UMKM",
    "frontend": "Svelte",
    "backend": "Golang",
    "database": "MySQL",
    "authentication": "JWT",
    "architecture": "REST API"
  },
  "roles": {
    "buyer": {
      "description": "Pengguna marketplace"
    },
    "seller": {
      "description": "Pemilik toko"
    }
  },
  "database": {
    "tables": [
      {
        "name": "users",
        "columns": [
          {
            "name": "id",
            "type": "BIGINT",
            "primary_key": true,
            "auto_increment": true
          },
          {
            "name": "full_name",
            "type": "VARCHAR(100)"
          },
          {
            "name": "email",
            "type": "VARCHAR(100)",
            "unique": true
          },
          {
            "name": "phone",
            "type": "VARCHAR(20)"
          },
          {
            "name": "password_hash",
            "type": "TEXT"
          },
          {
            "name": "role",
            "type": "ENUM('buyer','seller')",
            "default": "buyer"
          },
          {
            "name": "profile_image_url",
            "type": "TEXT"
          },
          {
            "name": "is_verified",
            "type": "BOOLEAN",
            "default": false
          },
          {
            "name": "last_login_at",
            "type": "TIMESTAMP",
            "nullable": true
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP"
          },
          {
            "name": "updated_at",
            "type": "TIMESTAMP"
          }
        ]
      },
      {
        "name": "stores",
        "columns": [
          {
            "name": "id",
            "type": "BIGINT",
            "primary_key": true,
            "auto_increment": true
          },
          {
            "name": "user_id",
            "type": "BIGINT",
            "foreign_key": "users.id",
            "unique": true
          },
          {
            "name": "store_name",
            "type": "VARCHAR(100)"
          },
          {
            "name": "description",
            "type": "TEXT"
          },
          {
            "name": "profile_image_url",
            "type": "TEXT"
          },
          {
            "name": "banner_image_url",
            "type": "TEXT"
          },
          {
            "name": "city",
            "type": "VARCHAR(100)"
          },
          {
            "name": "province",
            "type": "VARCHAR(100)"
          },
          {
            "name": "rating_avg",
            "type": "DECIMAL(2,1)"
          },
          {
            "name": "followers_count",
            "type": "INT",
            "default": 0
          },
          {
            "name": "total_sales",
            "type": "INT",
            "default": 0
          },
          {
            "name": "is_active",
            "type": "BOOLEAN",
            "default": true
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP"
          }
        ]
      },
      {
        "name": "categories",
        "columns": [
          {
            "name": "id",
            "type": "BIGINT",
            "primary_key": true,
            "auto_increment": true
          },
          {
            "name": "parent_id",
            "type": "BIGINT",
            "foreign_key": "categories.id",
            "nullable": true
          },
          {
            "name": "category_name",
            "type": "VARCHAR(100)"
          },
          {
            "name": "slug",
            "type": "VARCHAR(100)"
          }
        ]
      },
      {
        "name": "products",
        "columns": [
          {
            "name": "id",
            "type": "BIGINT",
            "primary_key": true,
            "auto_increment": true
          },
          {
            "name": "store_id",
            "type": "BIGINT",
            "foreign_key": "stores.id"
          },
          {
            "name": "category_id",
            "type": "BIGINT",
            "foreign_key": "categories.id"
          },
          {
            "name": "product_name",
            "type": "VARCHAR(150)"
          },
          {
            "name": "slug",
            "type": "VARCHAR(150)"
          },
          {
            "name": "sku",
            "type": "VARCHAR(100)"
          },
          {
            "name": "price",
            "type": "DECIMAL(12,2)"
          },
          {
            "name": "rating_avg",
            "type": "DECIMAL(2,1)"
          },
          {
            "name": "total_sales",
            "type": "INT",
            "default": 0
          },
          {
            "name": "view_count",
            "type": "INT",
            "default": 0
          },
          {
            "name": "stock",
            "type": "INT"
          },
          {
            "name": "weight",
            "type": "INT"
          },
          {
            "name": "description",
            "type": "TEXT"
          },
          {
            "name": "is_active",
            "type": "BOOLEAN",
            "default": true
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP"
          },
          {
            "name": "updated_at",
            "type": "TIMESTAMP"
          }
        ]
      },
      {
        "name": "product_images",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "product_variants",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "carts",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "cart_items",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "wishlists",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "shipping_addresses",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "orders",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "order_items",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "payments",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "reviews",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "review_images",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "chats",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "chat_messages",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "notifications",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "notification_settings",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "store_vouchers",
        "description": "See design specification",
        "columns": []
      },
      {
        "name": "banners",
        "description": "See design specification",
        "columns": []
      }
    ]
  },
  "relationships": [
    "users.id -> stores.user_id",
    "stores.id -> products.store_id",
    "categories.id -> products.category_id",
    "products.id -> product_images.product_id",
    "products.id -> product_variants.product_id",
    "users.id -> carts.user_id",
    "carts.id -> cart_items.cart_id",
    "products.id -> cart_items.product_id",
    "users.id -> wishlists.user_id",
    "products.id -> wishlists.product_id",
    "users.id -> shipping_addresses.user_id",
    "users.id -> orders.buyer_id",
    "orders.id -> order_items.order_id",
    "orders.id -> payments.order_id",
    "products.id -> reviews.product_id",
    "reviews.id -> review_images.review_id",
    "chats.id -> chat_messages.chat_id"
  ]
}